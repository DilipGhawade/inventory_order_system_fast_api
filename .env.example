# Application Settings
PROJECT_NAME="Enterprise Inventory & Order Management API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & JWT Configuration
SECRET_KEY="f9bf78b9a18ce6d46a0cd2b0b86df9da8f3451c29b3e1a7c45e87a90d1e2b3c4"
REFRESH_SECRET_KEY="a1b2c3d4e5f60718293a4b5c6d7e8f901a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Database Configuration (PostgreSQL Async)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="inventory_user"
POSTGRES_PASSWORD="inventory_secure_password"
POSTGRES_DB="inventory_db"
DATABASE_URL="postgresql+asyncpg://inventory_user:inventory_secure_password@localhost:5432/inventory_db"
TEST_DATABASE_URL="postgresql+asyncpg://inventory_user:inventory_secure_password@localhost:5432/inventory_test_db"

# Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","*"]

# Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true